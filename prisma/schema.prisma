datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

model Empresario {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  correo    String   @unique
  telefono  String
  estado    String   @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocios           Negocio[]
  vendedores         Vendedor[]
  clientes           Cliente[]
  productosServicios ProductoServicio[]
  ventas             Venta[]
  usuarios           Usuario[]

  @@map("empresarios")
}

model Negocio {
  id                 String   @id @default(uuid())
  empresarioId       String
  empresario         Empresario @relation(fields: [empresarioId], references: [id], onDelete: Cascade)
  nombre             String
  rubro              String?
  telefono           String
  correo             String
  porcentajeGanancia Float    @default(10.00)
  estado             String   @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rubros             Rubro[]
  vendedores         Vendedor[]
  clientes           Cliente[]
  productosServicios ProductoServicio[]
  ventas             Venta[]

  @@map("negocios")
}

model Rubro {
  id          String   @id @default(uuid())
  negocioId   String
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  estado      String   @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendedores         Vendedor[]
  productosServicios ProductoServicio[]
  clientes           Cliente[]
  ventas             Venta[]

  @@map("rubros")
}

model Vendedor {
  id                 String      @id @default(uuid())
  empresarioId       String?
  empresario         Empresario? @relation(fields: [empresarioId], references: [id], onDelete: SetNull)
  negocioId          String
  negocio            Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  rubroId            String?
  rubro              Rubro?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  nombre             String
  apellido           String
  correo             String      @unique
  telefono           String
  dui                String      @unique
  contrasena         String
  estado             String      @default("ACTIVO") // ACTIVO, INACTIVO, BLOQUEADO
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt

  clientes           Cliente[]
  ventas             Venta[]
  usuarios           Usuario[]

  @@map("vendedores")
}

model Cliente {
  id            String      @id @default(uuid())
  empresarioId  String?
  empresario    Empresario? @relation(fields: [empresarioId], references: [id], onDelete: SetNull)
  negocioId     String?
  negocio       Negocio?    @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  rubroId       String?
  rubro         Rubro?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  vendedorId    String
  vendedor      Vendedor    @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  nombre        String
  apellido      String
  telefono      String
  correo        String
  dui           String?
  direccion     String?
  observaciones String?
  estado        String      @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ventas        Venta[]

  @@map("clientes")
}

model ProductoServicio {
  id          String      @id @default(uuid())
  empresarioId String?
  empresario  Empresario? @relation(fields: [empresarioId], references: [id], onDelete: SetNull)
  negocioId   String
  negocio     Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  rubroId     String?
  rubro       Rubro?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  nombre      String
  descripcion String?
  codigo      String?
  tipo        String      @default("PRODUCTO") // PRODUCTO, SERVICIO
  precio      Float       @default(0.0)
  estado      String      @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  detalles    VentaDetalle[]

  @@map("productos_servicios")
}

model Venta {
  id                 String      @id @default(uuid())
  empresarioId       String?
  empresario         Empresario? @relation(fields: [empresarioId], references: [id], onDelete: SetNull)
  negocioId          String
  negocio            Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  rubroId            String?
  rubro              Rubro?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  vendedorId         String
  vendedor           Vendedor    @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  clienteId          String
  cliente            Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fechaVenta         DateTime    @default(now())
  subtotal           Float       @default(0.0)
  descuento          Float       @default(0.0)
  total              Float       @default(0.0)
  porcentajeGanancia Float       @default(0.0)
  montoGanancia      Float       @default(0.0)
  observaciones      String?
  estado             String      @default("COMPLETADA") // COMPLETADA, ANULADA, PENDIENTE
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  detalles           VentaDetalle[]

  @@map("ventas")
}

model VentaDetalle {
  id                     String           @id @default(uuid())
  ventaId                String
  venta                  Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoServicioId     String
  productoServicio       ProductoServicio @relation(fields: [productoServicioId], references: [id], onDelete: Cascade)
  nombreProductoSnapshot String?
  cantidad               Int              @default(1)
  precioUnitario         Float            @default(0.0)
  descuento              Float            @default(0.0)
  subtotal               Float            @default(0.0)

  @@map("venta_detalles")
}

model Usuario {
  id           String      @id @default(uuid())
  correo       String      @unique
  contrasena   String
  nombre       String
  apellido     String
  role         String      @default("VENDEDOR") // SUPER_ADMIN, EMPRESARIO, VENDEDOR
  empresarioId String?
  empresario   Empresario? @relation(fields: [empresarioId], references: [id], onDelete: SetNull)
  vendedorId   String?
  vendedor     Vendedor?   @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("usuarios")
}
